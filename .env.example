# IONOS API Token (JWT from DCD Token Manager)
# This is the admin/owner token used to bootstrap the app.
# After first run, the app manages its own token lifecycle.
IONOS_API_TOKEN=your-ionos-jwt-token-here

# Encryption key for stored credentials (auto-generated on first run if not set)
# 64 hex characters = 32 bytes for AES-256-GCM
# ENCRYPTION_KEY=

# Server port (default: 3001)
# PORT=3001

# Host binding (default: 127.0.0.1 — change to 0.0.0.0 for external access)
# HOST=127.0.0.1
