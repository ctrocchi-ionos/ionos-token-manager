# Data directory — must point to a persistent volume in containers.
# The database (tokenmanager.db) and encryption key (encryption.key) are stored here.
# Default: /data
# DATA_DIR=/data

# IONOS API Token (JWT from DCD Token Manager)
# Optional: if not set, the app shows a first-run setup page where you can paste it.
# After the first run the token is stored encrypted in the database.
# IONOS_API_TOKEN=your-ionos-jwt-token-here

# Encryption key for stored credentials.
# Optional: auto-generated on first run and saved to DATA_DIR/encryption.key.
# You can override it here (64 hex characters = 32 bytes for AES-256-GCM).
# ENCRYPTION_KEY=

# Server port (default: 3000)
# PORT=3000

# Host binding (default: 0.0.0.0 — listens on all interfaces)
# HOST=0.0.0.0
