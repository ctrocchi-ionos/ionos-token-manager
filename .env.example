# Data directory — must point to a persistent volume in containers.
# Holds the per-user workspaces (workspaces/), the key-check fingerprint file, and, if present,
# the old encryption.key and tokenmanager.db.migrated-* files from before the workspace upgrade.
# Default: /data
# DATA_DIR=/data

# Master key (64 hex characters). On a brand-new install the app generates it and adds it
# here automatically. On the marketplace, put it in the app's .env. Keep a copy somewhere safe:
# without it, stored tokens cannot be read. Never change it on an existing install (the app
# refuses to start if it differs from the key the data was created with).
# ENCRYPTION_KEY=

# Server port (default: 3000)
# PORT=3000

# Host binding (default: 0.0.0.0 — listens on all interfaces)
# HOST=0.0.0.0

# Optional. Shared secret the SSO proxy sends as X-Proxy-Secret. Only needed if the app could be
# reached without the marketplace login. If set, it must be at least 32 characters
# (e.g. `openssl rand -hex 32`), otherwise the app refuses to start.
# PROXY_SECRET=

# Days after expiry before a token's IONOS user/group are deleted automatically (-1 = off).
# EXPIRED_CLEANUP_GRACE_DAYS=7

# Only for upgrading an old single-user install whose tokens have no owner recorded.
# LEGACY_OWNER_EMAIL=you@ionos.com

# Local development only (used by `npm run dev`, ignored by `npm start`).
# DEV_AUTH_EMAIL=you@example.com
