# IONOS Token Manager 2.0 — copy to .env and adjust. Write values without quotes.
# A real environment variable wins over the same name in this file.

# Data directory — must point to a persistent volume in containers.
# Holds the per-user workspaces (workspaces/), the master key safety copy (encryption.key),
# the key fingerprint (key-check) and, after an upgrade from 1.x, tokenmanager.db.migrated-*.
# Default: server/data
# DATA_DIR=/data

# Master key (64 hex characters). On a brand-new install the app generates it, writes it to
# DATA_DIR/encryption.key and appends it here (if this file exists). If unset, the app reads
# DATA_DIR/encryption.key. Keep a copy somewhere safe: without it, stored tokens cannot be read.
# Never change it on an existing install: the app refuses to start with a different key.
# ENCRYPTION_KEY=

# Server port (default: 3000)
# PORT=3000

# Host binding (default: 0.0.0.0 — all interfaces; 127.0.0.1 keeps it on this machine)
# HOST=0.0.0.0

# Optional. Shared secret the SSO proxy sends as X-Proxy-Secret. Set it if the port can be
# reached without the SSO login. At least 32 characters (e.g. `openssl rand -hex 32`),
# otherwise the app refuses to start.
# PROXY_SECRET=

# Days after expiry before a token's IONOS user/group are deleted automatically (-1 = off).
# EXPIRED_CLEANUP_GRACE_DAYS=7

# Only for installs older than 1.1, whose rows have no owner: the email that owns them.
# Needed to upgrade such an install (the app refuses to start without it) and to restore its old backups.
# LEGACY_OWNER_EMAIL=you@example.com

# Built frontend (default: <project>/public). Rarely needs changing.
# PUBLIC_DIR=

# Local development only (used by `npm run dev`, ignored by `npm start`).
# DEV_AUTH_EMAIL=you@example.com
